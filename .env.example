# RAKSHA AI — Environment Configuration
# Copy this file to .env and configure variables as needed

# Server Port (Render sets this automatically)
PORT=3000

# Environment Mode
NODE_ENV=production

# Google Gemini API Key (Optional: Can also be set in-app via UI)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
